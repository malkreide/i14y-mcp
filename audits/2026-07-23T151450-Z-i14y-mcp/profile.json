{
  "name": "i14y-mcp",
  "repo": "https://github.com/malkreide/i14y-mcp",
  "transport": "dual",
  "sdk_language": "Python",
  "auth_model": "none",
  "data_class": "Public Open Data",
  "write_capable": false,
  "deployment": ["local-stdio", "Render", "Railway"],
  "is_cloud_deployed": true,
  "uses_sampling": false,
  "uses_sequential_thinking": false,
  "tools_include_filesystem": false,
  "tools_make_external_requests": true,
  "stadt_zuerich_context": false,
  "schulamt_context": false,
  "volksschule_context": false,
  "enterprise_context": false,
  "data_source": {
    "is_swiss_open_data": true,
    "provider": "I14Y Interoperability Platform / Swiss Federal Statistical Office (BFS)",
    "base_url": "https://api.i14y.admin.ch/api"
  }
}
