{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.malkreide/i14y-mcp",
  "description": "MCP server for the I14Y interoperability platform — Switzerland's national metadata catalogue (DCAT-AP-CH / eCH-0200)",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/malkreide/i14y-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/malkreide/i14y-mcp",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "i14y-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "uvx"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "category": "Statistics & Geodata",
      "scope": "core"
    }
